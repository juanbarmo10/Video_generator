# Copia este archivo a .env y rellena las claves.
# ⚠️ .env NUNCA se commitea: tiene claves reales en texto plano.

# ── API KEYS ──────────────────────────────────────────────────
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=

# Opcional. Si está, el crítico del guion (paso 01) corre en Claude en vez de
# GPT: un modelo de otro proveedor no comparte los puntos ciegos del generador.
# Sin esta clave el crítico cae a gpt-4.1 y el pipeline funciona igual.
ANTHROPIC_API_KEY=

# Opcional. Solo lo usa el recordatorio semanal
# (herramientas/12_recordatorio.py); sin esto imprime por consola y no envía.
# Token: háblale a @BotFather → /newbot.
# chat_id: escríbele al bot y abre https://api.telegram.org/bot<TOKEN>/getUpdates
# ⚠️ El chat_id va fijo: un bot que conteste a quien le escriba deja que
#    cualquiera lea tus métricas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ya no se usan (código muerto / comentado), se dejan por compatibilidad:
LEONARDO_API_KEY=
FISH_API_KEY=
GOOGLE_TTS_API_KEY=

# ── PARAMS ────────────────────────────────────────────────────
# Los escriben los scripts, NO a mano:
#   PROYECTO / TEMA  → run_all.sh
#   TITULO_VIDEO     → paso 02
PROYECTO=
TEMA=
TITULO_VIDEO=

# ── Meta (Instagram + Facebook) — opcional ────────────────────
# Para leer métricas (herramientas/14_meta_api.py --metricas) y publicar.
# El token se genera en el Explorador de la API Graph con estos permisos:
#   instagram_basic, instagram_content_publish, instagram_manage_insights,
#   pages_show_list, pages_read_engagement, pages_manage_posts, read_insights
# Los IDs los descubre `--diagnostico` solo; se guardan aquí para no repetir
# la búsqueda en cada corrida.
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
