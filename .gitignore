# ── SECRETOS — nunca commitear ────────────────────────────────
# .env no es solo configuración: tiene las claves de OpenAI, ElevenLabs y fal
# en texto plano, y además es estado mutable del pipeline (PROYECTO, TEMA).
.env
.env.*
!.env.example

# ── Salidas del pipeline (pesadas, regenerables) ──────────────
videos/
videos_no_music/
proyectos/
logs/
carousel_slides/
images_IA/
images_IA_guidance/
source_images/
social_posts/
voice_samples/

# ── Estado del tema en curso ──────────────────────────────────
script.txt
voice.mp3
*.mp3
.estado_actual
.costo_actual.json

# ── Credenciales de Google (YouTube Analytics API) ────────────
# ⚠️ Las dos son secretos, igual que el .env:
#   client_secret*.json  lo descargas de Google Cloud Console
#   token_youtube.json   lo escribe el flujo OAuth y da acceso REAL a las
#                        analíticas del canal hasta que lo revoques
# Van con comodín porque Google las descarga con un nombre larguísimo del tipo
# client_secret_1234-abcd.apps.googleusercontent.com.json.
client_secret*.json
token_youtube.json
credenciales/

# ── Assets pesados que no cambian ─────────────────────────────
music/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# ── Editor / SO ───────────────────────────────────────────────
.vscode/
.DS_Store

# Zips de fuentes (ya están extraídas en fonts/)
fonts/*.zip

# Cache de fotos reales convertidas a 9:16 (paso 07)
.cache_fotos_reales/

# Temporales de moviepy (se cuelan si se hace git add durante un render)
*TEMP_MPY*

# Config local de Claude Code (rutas y permisos de esta máquina)
.claude/settings.local.json

# Paquete de publicacion (videos con hardlink + textos, regenerable)
publicar/

# Exports crudos de las plataformas (ruido; el consolidado va en metricas.csv)
metricas_export/

# Informes HTML (derivados: se rehacen con `python herramientas/11_reporte.py`,
# y metricas.csv —que sí está en git— guarda todas las fotos históricas)
reportes/

# Fecha del último recordatorio enviado (estado local de esta máquina)
.ultimo_recordatorio

# Muestras de comparacion de ritmo (P-15), regenerables
muestras_p15/
